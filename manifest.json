{
  "manifest_version": 3,
  "name": "划词翻译",
  "version": "1.0.0",
  "description": "选中网页文字，在光标旁显示翻译。Translate selected text in a compact panel beside the cursor.",
  "author": "codemanhr",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "contextMenus"],
  "commands": {
    "force-translate": {
      "suggested_key": { "default": "Alt+T" },
      "description": "强制翻译当前选区"
    },
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "开启或关闭划词翻译"
    }
  },
  "host_permissions": [
    "https://www.bing.com/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "划词翻译",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/lib/constants.js",
        "src/lib/languages.js",
        "src/lib/settings.js",
        "src/lib/clipboard.js",
        "src/lib/speech.js",
        "src/lib/blacklist.js",
        "src/lib/history.js",
        "src/lib/code-detector.js",
        "src/lib/detect.js",
        "src/lib/direction.js",
        "src/lib/panel-logic.js",
        "src/lib/position.js",
        "src/content/panel.css.js",
        "src/content/panel.js",
        "src/lib/messaging.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; img-src 'self' data:"
  }
}
